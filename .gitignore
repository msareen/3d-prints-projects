__pycache__/
*.pyc

# pipeline scratch: a build writes here first and only moves into model/ when printcheck passes
projects/*/processed/.build-tmp/
projects/*/output/.*.tmp
projects/*/processed/.mat-*/

# stage 2 working model: `pipeline build` regenerates it from build.py; the released copies live in output/
projects/*/processed/model/

# uv environment (uv sync); uv.lock is committed
.venv/

# showcase build output (showcase/build.py); GitHub Pages builds its own copy
_site/
